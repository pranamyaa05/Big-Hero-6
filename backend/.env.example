# Copy to .env and edit. Nothing here is required: with no model configured the server still serves the 36 ready-made templates.
# Comments are on their own lines on purpose: `docker --env-file` does not strip comments after a value.

# ---- the model that designs parts from scratch ----
# Option 1: Claude (best results). Model defaults to claude-sonnet-5-5; override with REFORM3D_LLM_MODEL.
REFORM3D_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Option 2: any OpenAI-compatible server. Presets: gemini, openrouter, groq, deepseek, zai (Zhipu GLM), ollama,
# or "openai" with your own REFORM3D_LLM_BASE_URL. For these, REFORM3D_LLM_MODEL is required: use a current name from the provider's docs.
#
# Gemini:
# REFORM3D_LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# REFORM3D_LLM_MODEL=
#
# Free Qwen3-Coder through OpenRouter (text only, so turn vision off):
# REFORM3D_LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# REFORM3D_LLM_MODEL=qwen/qwen3-coder:free
# REFORM3D_LLM_VISION=false
#
# DeepSeek: REFORM3D_LLM_PROVIDER=deepseek and DEEPSEEK_API_KEY.  Zhipu GLM: REFORM3D_LLM_PROVIDER=zai and ZAI_API_KEY.
#
# A model you run yourself, no key needed:
# REFORM3D_LLM_PROVIDER=ollama
# REFORM3D_LLM_MODEL=qwen2.5-coder:32b
#
# vLLM, llama.cpp server, a fine-tuned model of your own:
# REFORM3D_LLM_PROVIDER=openai
# REFORM3D_LLM_BASE_URL=http://localhost:8001/v1
# REFORM3D_LLM_API_KEY=

# ---- several free models at once (optional) ----
# Entries are provider=model, best first. Each provider uses its usual key variable. Add +text after a model that cannot see pictures, +vision for one that can.
# Providers: anthropic, gemini, openrouter, groq, cerebras, nvidia, mistral, sambanova, cloudflare (also needs CLOUDFLARE_ACCOUNT_ID), deepseek, zai, ollama.
# Use current model names from each provider's docs. A model that fails or runs out of quota rests, and the call moves to the next one.
# REFORM3D_LLM_POOL="cerebras=gpt-oss-120b+text, openrouter=qwen/qwen3-coder:free+text"
# CEREBRAS_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# More than 1 makes that many different pool models design the same part at once (uses that many times the quota).
REFORM3D_DESIGN_CANDIDATES=1
# first = the first valid design wins. best = wait up to the grace seconds for the others and keep the best-ranked one.
REFORM3D_DESIGN_RACE=first
REFORM3D_DESIGN_RACE_GRACE=60

# false for text-only models: photos are not sent and the self-review uses measurements instead of a picture.
REFORM3D_LLM_VISION=true
# false forces the offline template mode.
REFORM3D_ENABLE_LLM=true
# false: never run model-written code, templates only.
REFORM3D_ENABLE_DESIGN=true
# Code attempts per design; each one gets the previous error back.
REFORM3D_DESIGN_ATTEMPTS=4
# Times the model is shown a picture (or measurements) of its own result. 0 = off, saves one model call.
REFORM3D_REVIEW_ROUNDS=1
# Seconds allowed to run one design's code, and its memory limit.
REFORM3D_DESIGN_TIMEOUT=40
REFORM3D_DESIGN_MEMORY_MB=1536
# Seconds per model call.
REFORM3D_LLM_TIMEOUT=120

# ---- the service ----
REFORM3D_DATA_DIR=./data
# Leave empty to allow open access. If set, POST and DELETE need an X-API-Key header. Do not put this key in a public web page.
REFORM3D_API_KEY=
# Comma-separated site origins allowed to call the API from a browser. Use your own site, not *, in production.
REFORM3D_CORS_ORIGINS=*
# Requests per minute per client IP, 0 = off.
REFORM3D_RATE_LIMIT=20
# true only behind a proxy you control that sets X-Forwarded-For.
REFORM3D_TRUST_PROXY=false
# Parallel jobs, and seconds allowed for the build step of one job.
REFORM3D_WORKERS=2
REFORM3D_JOB_TIMEOUT=120
REFORM3D_MAX_UPLOAD_MB=8
# Jobs and files older than this are deleted at start-up.
REFORM3D_RETENTION_DAYS=14
# Print bed in mm, for the size warning.
REFORM3D_BED_X=220
REFORM3D_BED_Y=220
REFORM3D_BED_Z=250
REFORM3D_RENDER_PREVIEW=true
# PrusaSlicer for real print time, plastic and support numbers. auto = use it if installed, off, or a path to the binary.
REFORM3D_SLICER=auto
# Slice each design attempt and tell the model if it needs lots of support.
REFORM3D_SLICER_LOOP=true
REFORM3D_SLICER_TIMEOUT=60
# A shorter standing prompt (about 3.6k tokens instead of 4.9k) for providers with a small tokens-per-minute limit.
REFORM3D_PROMPT_LEAN=false
